# Create deeply nested rule
ltm rule deep_nested_rule {
    when HTTP_REQUEST {
        if { [HTTP::host] equals "api.example.com" } {
            if { [HTTP::uri] starts_with "/v1" } {
                if { [HTTP::method] equals "GET" } {
                    pool api_v1_get_pool
                } elseif { [HTTP::method] equals "POST" } {
                    pool api_v1_post_pool
                } else {
                    pool api_v1_default_pool
                }
            } elseif { [HTTP::uri] starts_with "/v2" } {
                if { [HTTP::method] equals "GET" } {
                    pool api_v2_get_pool
                } elseif { [HTTP::method] equals "POST" } {
                    pool api_v2_post_pool
                } else {
                    pool api_v2_default_pool
                }
            } else {
                pool api_default_pool
            }
        } elseif { [HTTP::host] equals "web.example.com" } {
            pool web_pool
        } else {
            pool default_pool
        }
    }
}

