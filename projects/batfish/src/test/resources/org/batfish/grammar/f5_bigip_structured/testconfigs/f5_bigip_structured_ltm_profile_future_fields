#TMSH-VERSION: 13.1.1

sys global-settings {
  hostname f5_bigip_structured_ltm_profile_future_fields
}

# Test LTM profile client-ssl with new fields - should not generate warnings
ltm profile client-ssl /Common/test-client-ssl {
    alert-timeout indefinite
    allow-dynamic-record-sizing disabled
    allow-non-ssl disabled
    app-service none
    cache-size 262144
    cache-timeout 3600
    cert /Common/example1.crt
    cert-extension-includes { basic-constraints subject-alternative-name }
    cert-key-chain {
       chain1 {
          cert /Common/example2.crt
          key /Common/example2.key
          new-chain-field value1
       }
    }
    cert-include-chain enabled
    cert-lifetime-in-secs 123456
    cipher-list {
        DEFAULT
        ECDHE-RSA-AES128-GCM-SHA256
        new-cipher-entry test123
    }
    ciphers {
        DEFAULT
        ECDHE-RSA-AES128-GCM-SHA256
        another-new-cipher test456
    }
    client-cert-ca unknown-g17-1.crt
    client-cert-crl unknown-g17-1.crl
    new-client-ssl-field value1
    another-ssl-option value2
}

# Test LTM profile server-ssl with new fields - should not generate warnings
ltm profile server-ssl /Common/test-server-ssl {
    alert-timeout indefinite
    app-service none
    auth-name disabled
    cache-size 262144
    cache-timeout 3600
    cert /Common/example1.crt
    cert-extension-includes { basic-constraints subject-alternative-name }
    chain unknown-g17-2.crt
    cipher-list {
        DEFAULT
        ECDHE-RSA-AES128-GCM-SHA256
        new-server-cipher value1
    }
    ciphers {
        DEFAULT
        ECDHE-RSA-AES128-GCM-SHA256
        future-server-cipher value2
    }

