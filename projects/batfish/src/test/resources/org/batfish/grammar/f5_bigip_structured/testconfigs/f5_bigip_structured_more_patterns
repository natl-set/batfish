#TMSH-VERSION: 11.6.0
# Test config with more patterns from real F5 configs

sys global-settings {
    hostname f5_bigip_structured_more_patterns
}

# Pattern 1: LTM monitor with various fields
ltm monitor http /Common/test-http-monitor {
    adaptive disabled
    defaults-from /Common/http
    destination *:*
    interval 5
    ip-dscp 0
    recv "HTTP/1.1 200"
    send "GET / HTTP/1.1\r\nHost: test.example.com\r\nConnection: close\r\n\r\n"
    time-until-up 0
    timeout 16
}

# Pattern 2: LTM persistence cookie with all fields
ltm persistence cookie /Common/test-cookie-persist {
    always-send disabled
    app-service none
    cookie-encryption disabled
    cookie-name BIGIPCOOKIE
    defaults-from /Common/cookie
    expiration 0
    method insert
    override-connection-limit disabled
    timeout 180
}

# Pattern 3: LTM persistence source-addr
ltm persistence source-addr /Common/test-source-persist {
    app-service none
    defaults-from /Common/source_addr
    hash-algorithm default
    map-proxies enabled
    mask 255.255.255.0
    match-across-pools disabled
    match-across-services disabled
    match-across-virtuals disabled
    override-connection-limit enabled
    timeout 180
}

# Pattern 4: LTM persistence hash
ltm persistence hash /Common/test-hash-persist {
    app-service none
    defaults-from /Common/hash
    hash-algorithm default
    hash-buffer-limit 0
    hash-end-pattern none
    hash-length 15
    hash-offset 3
    hash-start-pattern none
    match-across-pools disabled
    match-across-services disabled
    match-across-virtuals disabled
    override-connection-limit disabled
    rule none
    timeout 180
}

# Pattern 5: LTM virtual-address
ltm virtual-address /Common/10.90.191.100 {
    address 10.90.191.100
    arp enabled
    icmp-echo enabled
    mask 255.255.255.255
    traffic-group /Common/traffic-group-1
}

# Pattern 6: LTM snatpool
ltm snatpool /Common/test-snat-pool {
    members {
        /Common/192.168.39.60
        /Common/192.168.39.61
        /Common/192.168.39.62
    }
}

# Pattern 7: LTM snat-translation (simplified - some fields not in grammar)
ltm snat-translation /Common/192.168.39.62 {
    address 192.168.39.62
    traffic-group /Common/traffic-group-1
}

# Pattern 8: Net route
net route /Common/test-route {
    gateway 192.168.1.1
    network 10.0.0.0/8
}

# Pattern 9: Simple pool for verification
ltm pool test_verify_pool {
    members {
        server1:80 {}
        server2:80 {}
    }
}

# Pattern 10: Virtual with many profiles
ltm virtual /Common/test-complex-vip {
    destination 10.90.191.100:443
    ip-protocol tcp
    mask 255.255.255.255
    pool /Common/test_verify_pool
    profiles {
        /Common/clientssl { }
        /Common/serverssl { }
        /Common/http { }
        /Common/tcp { }
    }
    source 0.0.0.0/0
    source-address-translation {
        pool /Common/test-snat-pool
        type snat
    }
    translate-address enabled
    translate-port enabled
}
