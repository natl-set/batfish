# Test 24: Rule with empty conditional
ltm rule test_empty_conditional {
    when HTTP_REQUEST {
        if { 0 } { }
    }
}

# Test 25: Chained conditionals
ltm rule test_chained {
    when HTTP_REQUEST {
        if { [HTTP::host] equals "a" } { pool pool_a }
        if { [HTTP::host] equals "b" } { pool pool_b }
        if { [HTTP::host] equals "c" } { pool pool_c }
    }
}
