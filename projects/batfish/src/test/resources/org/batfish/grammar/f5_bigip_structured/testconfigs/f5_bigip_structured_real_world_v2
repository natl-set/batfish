#TMSH-VERSION: 15.1.10.3
# Real-world patterns from actual F5 configs (bigip_v11.conf style)

sys global-settings {
    hostname f5_bigip_structured_real_world_v2
}

# Pattern 1: Default node monitor
ltm default-node-monitor {
    rule none
}

# Pattern 2: Monitor with description
ltm monitor tcp /Common/F5-Monitor-TCP-001 {
    adaptive disabled
    defaults-from /Common/tcp
    destination *:*
    interval 60
    time-until-up 0
    timeout 121
}

# Pattern 3: Monitor with send/recv strings
ltm monitor http /Common/F5-Monitor-HTTP-001 {
    adaptive disabled
    debug no
    defaults-from /Common/http
    destination *:*
    interval 5
    recv "HTTP/1.1 200"
    send "GET /health HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n"
    time-until-up 0
    timeout 16
}

# Pattern 4: Persistence with expiration time format
ltm persistence cookie /Common/testexpiration {
    always-send disabled
    app-service none
    cookie-encryption disabled
    cookie-name none
    defaults-from /Common/cookie
    expiration 4:3:2
    method insert
    override-connection-limit disabled
    timeout 180
}

# Pattern 5: Hash persistence with all options
ltm persistence hash /Common/Bigip-Persist-Hash {
    app-service none
    defaults-from /Common/hash
    hash-algorithm default
    hash-buffer-limit 0
    hash-end-pattern none
    hash-length 15
    hash-offset 3
    hash-start-pattern none
    match-across-pools disabled
    match-across-services disabled
    match-across-virtuals disabled
    override-connection-limit disabled
    rule none
    timeout 180
}

# Pattern 6: Source address persistence with mask
ltm persistence source-addr /Common/Bigip-Persist-SourceAddressAffinity {
    app-service none
    defaults-from /Common/source_addr
    hash-algorithm default
    map-proxies enabled
    mask 255.255.255.0
    match-across-pools disabled
    match-across-services disabled
    match-across-virtuals disabled
    override-connection-limit enabled
    timeout 180
}

# Pattern 7: Virtual address
ltm virtual-address /Common/10.90.191.100 {
    address 10.90.191.100
    arp enabled
    icmp-echo enabled
    mask 255.255.255.255
    traffic-group /Common/traffic-group-1
}

# Pattern 8: SNAT pool
ltm snatpool /Common/Snat_pool_1 {
    members {
        /Common/192.168.39.60
        /Common/192.168.39.61
        /Common/192.168.39.62
    }
}

# Pattern 9: SNAT translation
ltm snat-translation /Common/192.168.39.62 {
    address 192.168.39.62
    traffic-group /Common/traffic-group-1
}

# Pattern 10: Pool for verification
ltm pool test_real_world_pool {
    members {
        server1:80 {}
        server2:80 {}
    }
    monitor /Common/F5-Monitor-HTTP-001
}

# Pattern 11: Virtual server with many options
ltm virtual /Common/F5-VIP-443-001 {
    destination 10.90.191.100:443
    ip-protocol tcp
    mask 255.255.255.255
    pool test_real_world_pool
    profiles {
        /Common/clientssl { }
        /Common/serverssl { }
        /Common/http { }
        /Common/tcp { }
    }
    source 0.0.0.0/0
    source-address-translation {
        pool /Common/Snat_pool_1
        type snat
    }
    translate-address enabled
    translate-port enabled
}
