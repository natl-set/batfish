#TMSH-VERSION: 15.1.10.3
# Edge case patterns extracted from F5 BIG-IP configurations
# All values have been sanitized for testing

sys global-settings {
    hostname f5_bigip_structured_dc1_dc2_patterns
}

# =============================================================================
# Security patterns
# =============================================================================

# Pattern 1: security protocol-inspection compliance
security protocol-inspection compliance /Common/test_compliance {
    description "Test compliance check"
    documentation "Test documentation string"
    id 11018
    performance-impact medium
    protocol "tcp, sctp"
    risk medium
    service /Common/test-service
    subscription no
}

# Pattern 2: security protocol-inspection compliance-map
security protocol-inspection compliance-map /Common/test_map {
    insp-id 10426
    key-type int
    value-type vector-string
}

# Pattern 3: security protocol-inspection compliance-objects
security protocol-inspection compliance-objects /Common/test_objects {
    insp-id 10229
    type vector-string
}

# Pattern 4: security ip-intelligence policy
security ip-intelligence policy /Common/test-policy { }

# Pattern 5: security scrubber profile
security scrubber profile /Common/test-scrubber {
    advertisement-ttl 300
}

# Pattern 6: security shared-objects port-list
security shared-objects port-list /Common/test_tcp_ports {
    ports {
        22 { }
        53 { }
        161 { }
        443 { }
        1029-1043 { }
    }
}

security shared-objects port-list /Common/test_udp_ports {
    ports {
        53 { }
        161 { }
        520 { }
    }
}

# =============================================================================
# Net patterns
# =============================================================================

# Pattern 7: net dns-resolver with nested forward-zones
net dns-resolver /Common/test-dns-resolver {
    forward-zones {
        example.com {
            nameservers {
                192.0.2.1:53 { }
            }
        }
        test.local {
            nameservers {
                192.0.2.2:53 { }
            }
        }
    }
}

# Pattern 8: net ipsec ike-daemon
net ipsec ike-daemon /Common/test-ikedaemon {
    log-publisher /Common/test-log-publisher
}

# Pattern 9: net stp with interfaces
net stp /Common/test-stp {
    interfaces {
        1.3 {
            external-path-cost 500
            internal-path-cost 500
        }
        1.4 {
            external-path-cost 500
            internal-path-cost 500
        }
    }
}

# Pattern 10: net stp-globals
net stp-globals {
    config-name TEST-CONFIG-NAME
}

# =============================================================================
# Sys patterns
# =============================================================================

# Pattern 11: sys compatibility-level
sys compatibility-level {
    level 0
}

# Pattern 12: sys management-ovsdb
sys management-ovsdb {
    bfd-disabled
    bfd-route-domain none
    ca-cert-file none
    cert-file none
    cert-key-file none
    disabled
    flooding-type replicator
    log-level info
    logical-routing-type none
    tunnel-maintenance-mode active
}

# Pattern 13: sys turboflex profile-config
sys turboflex profile-config {
    type turboflex-adc
}

# Pattern 14: sys software update
sys software update {
    auto-check enabled
    auto-phonehome enabled
    frequency weekly
}

# =============================================================================
# PEM patterns
# =============================================================================

# Pattern 15: pem global-settings
pem global-settings analytics { }
pem global-settings gx { }
pem global-settings policy { }

# =============================================================================
# WOM patterns
# =============================================================================

# Pattern 16: wom deduplication and endpoint-discovery
wom deduplication {
    disabled
}
wom endpoint-discovery { }

# =============================================================================
# Security DOS patterns
# =============================================================================

# Pattern 17: security dos device-config with nested vectors
security dos device-config /Common/test-dos-config {
    dos-device-vector {
        arp-flood {
            allow-advertisement disabled
            allow-upstream-scrubbing disabled
            attacked-dst disabled
            auto-blacklisting disabled
            auto-scrubbing disabled
            bad-actor disabled
            blacklist-category /Common/test-category
        }
    }
}

# =============================================================================
# LTM patterns for verification
# =============================================================================

ltm pool test_pool {
    members {
        server1:80 { }
        server2:80 { }
    }
}
