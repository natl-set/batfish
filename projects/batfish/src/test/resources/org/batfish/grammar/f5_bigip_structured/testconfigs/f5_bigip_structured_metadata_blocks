#TMSH-VERSION: 1.0

sys global-settings {
    hostname f5_bigip_structured_metadata_blocks
}

# cm device - to extract device name for hostname matching
cm device /Common/f5_bigip_structured_metadata_blocks {
    base-mac 00:00:00:00:00:01
    hostname f5_bigip_structured_metadata_blocks
}

# Test cm cert blocks - should not generate warnings even with new metadata fields
cm cert /Common/test-cert-1.crt {
    certificate-key-size 2048
    checksum SHA1:value
    create-time 2019-10-10:15:26:27
    created-by devmgmtd
    expiration-date 1886106387
    expiration-string "Oct  7 22:26:27 2029 GMT"
    issuer CN=test
    key-type rsa-public
    last-update-time 2019-10-10:15:26:27
    mode 33188
    revision 1
    serial-number 684308
    size 1289
    subject CN=test
    updated-by devmgmtd
    version 3
    new-future-field value1
    another-new-field value2
}

cm cert /Common/test-cert-2.crt {
    checksum SHA256:value
    brand-new-metadata-field test123
}

# Test cm key blocks - should not generate warnings
cm key /Common/test-key-1.key {
    checksum SHA1:value
    create-time 2019-10-10:15:26:27
    created-by devmgmtd
    key-size 2048
    last-update-time 2019-10-10:15:26:27
    mode 33184
    revision 1
    size 1708
    updated-by devmgmtd
    future-key-field newvalue
}

# Test sys dns block - should not generate warnings
sys dns {
    name-servers 10.0.0.1 10.0.0.2
    search example.com
    new-dns-option value1
    another-dns-field value2
}

# Test sys management-ip - should not generate warnings
sys management-ip 10.0.1.1/24 {
}
sys management-ip 10.0.2.1/24 {
    new-management-field test
}

# Test sys management-route - should not generate warnings
sys management-route /Common/default {
    gateway 10.0.0.1
    network default
    new-route-field test123
}

# Test sys httpd - should not generate warnings
sys httpd {
    auth-pam-idle-timeout 600
    new-httpd-field value
}

# Test sys outbound-smtp - should not generate warnings
sys outbound-smtp {
    from-line-override disabled
    mailhub 10.0.0.1:25
    new-smtp-field test
}

# Test sys compatibility-level - should not generate warnings
sys compatibility-level {
    level 1
    new-compat-field value
}

# Test sys software-update - should not generate warnings
sys software-update {
    auto-check enabled
    auto-phonehome enabled
    new-update-field value
}

# Test analytics blocks - should not generate warnings
analytics gui-widget /Common/test-widget-1 {
    gui-pagecode /Common/test-page
    module ltm
    widget-type chart
    period 60
    new-metric-field value1
    another-metric-field value2
}

analytics gui-widget /Common/test-widget-2 {
    description "Test widget"
    username admin
    creation-time 2024-01-01:00:00:00
    brand-new-analytics-option test
}
