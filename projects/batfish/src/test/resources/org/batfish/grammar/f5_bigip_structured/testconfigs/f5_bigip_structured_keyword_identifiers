#TMSH-VERSION: 15.1.10.3
# Test config for keywords used as identifiers in various contexts

sys global-settings {
    hostname f5_bigip_structured_keyword_identifiers
}

# Test 1: pool used in name
ltm pool pool_test {
    members {
        server1:80 {}
    }
}

# Test 2: virtual used in name
ltm pool virtual_server_pool {
    members {
        server1:80 {}
    }
}

# Test 3: monitor used in name
ltm monitor http monitor_http_test {
    defaults-from /Common/http
    interval 5
    timeout 16
}

# Test 4: profile used in name
ltm profile http profile_test_http {
    defaults-from /Common/http
}

# Test 5: rule used in name
ltm rule rule_test_rule {
    when HTTP_REQUEST {
        pool pool_test
    }
}

# Test 6: persistence used in name
ltm persistence cookie persistence_test_cookie {
    defaults-from /Common/cookie
}

# Test 7: Multiple keywords in name
ltm pool pool_monitor_virtual_test {
    members {
        server1:80 {}
    }
}

# Test 8: Virtual with keyword-like names
ltm virtual virtual_test {
    destination 10.0.0.1:80
    pool pool_monitor_virtual_test
    profiles {
        /Common/http { }
        /Common/tcp { }
    }
}

# Test 9: Data-group with keyword-like name
ltm data-group internal data_group_pool {
    type string
    records {
        key1 { data value1 }
    }
}

# Test 10: Snatpool with keyword-like name
ltm snatpool snat_pool_members {
    members {
        /Common/10.0.0.100
    }
}
