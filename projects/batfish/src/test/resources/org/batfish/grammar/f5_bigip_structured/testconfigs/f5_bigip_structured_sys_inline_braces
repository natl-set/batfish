#TMSH-VERSION: 1.0.0

sys global-settings {
    hostname f5_bigip_structured_sys_inline_braces
}

# Test sys blocks using ignored_block with inline braces
# These should not generate parser warnings when using ignored_inline_braced_content

# Test sys sshd with inline braces
sys sshd {
    login { test }
    password-auth { enabled }
}

# Test sys dns with inline braces in values
sys dns {
    name-servers {
        10.0.0.1
        10.0.0.2
    }
    search { localdomain }
    forward-zones { example.com }
}

# Test sys management-ip with inline braces
sys management-ip 10.0.1.1/24 {
    default { gateway }
    unit-id 1
}

# Test sys syslog with multiple inline braces
sys syslog {
    remote-servers {
        log-server-1 {
            host 10.0.0.1
        }
        log-server-2 {
            host 10.0.0.2
        }
    }
}

# Test sys ntp with inline braces
sys ntp {
    servers { 10.0.0.1 10.0.0.2 }
    timezone { UTC }
}
