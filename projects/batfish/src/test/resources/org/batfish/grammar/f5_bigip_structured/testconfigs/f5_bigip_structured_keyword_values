#TMSH-VERSION: 15.1.10.3
# Test configuration to verify keyword tokens can be used as values
# This tests the fix for u_word rule that now includes: ACTIVE, ALL, ANY, DISABLED,
# ENABLED, FALSE, SELF, TRUE

sys global-settings {
    console-inactivity-timeout 600
    gui-setup disabled
    hostname f5_bigip_structured_keyword_values
}

# Test SELF keyword as interface name
net self self {
    address 10.0.0.1/24
}

# Test various keywords as values in different contexts
ltm pool /Common/test_pool_all {
    description all
}

ltm pool /Common/test_pool_any {
    description any
}

ltm pool /Common/test_pool_auto {
    description auto
}

# Test with boolean keywords
ltm pool /Common/test_pool_true {
    description true
}

ltm pool /Common/test_pool_false {
    description false
}

# Test with state keywords
ltm pool /Common/test_pool_enabled {
    description enabled
}

ltm pool /Common/test_pool_disabled {
    description disabled
}

ltm pool /Common/test_pool_active {
    description active
}

# Test action keyword
ltm pool /Common/test_pool_action {
    description action
}

# Test mode keyword
ltm pool /Common/test_pool_mode {
