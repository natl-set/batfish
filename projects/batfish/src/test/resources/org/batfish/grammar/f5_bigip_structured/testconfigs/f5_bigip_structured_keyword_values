# Test quoted string descriptions (should also work)
ltm pool /Common/test_pool_quoted {
    description "this is a quoted description"
}

# Test escaped quotes in descriptions (should unescape properly)
ltm pool /Common/test_pool_escaped_quotes {
    description "she said \"hello world\" to the pool"
}

# Test mixed keywords and quoted strings
